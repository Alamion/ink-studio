// =====================================================================
//  tavern.ink — диалог с циклом, glue, threads и тегами
// =====================================================================

=== tavern ===
~ last_place = -> tavern
{ tavern > 1: Опять ты. | Добро пожаловать!} — кричит трактирщик. # speaker: Трактирщик

// Thread: подмешиваем выборы из другого узла в текущий список
<- tavern_regulars

- (bar_loop)
// once-only: каждая фраза выводится один раз, потом ничего
{!Пахнет элем.|У камина спит собака.|}
+ {gold >= 2} [Купить эль (2 золота)]
    { spend(gold, 2):
        Ты пьёшь эль. <>
    }
    // <> glue — склеивает строки без переноса
    Осталось {gold} золота.
    -> bar_loop
+ {inventory !? key} [Спросить о ключе]
    "Ключ? За монету расскажу." # speaker: Трактирщик
    ++ {gold > 0} [Дать монету]
        ~ gold--
        ~ inventory += key
        Он протягивает тебе ржавый ключ.
    ++ [Отказаться]
        "Ну как знаешь."
    -- -> bar_loop
+ [Уйти] -> start

// Выборы этого узла добавляются через <- (thread) в таверну
=== tavern_regulars ===
* [Сыграть в кости с завсегдатаями]
    ~ temp roll = RANDOM(1, 6)
    Выпало {roll}.
    { roll > 3:
        ~ gold += 3
        Ты выиграл!
    - else:
        ~ take_damage(1)
        Проиграл и получил тумака. HP: {hp}.
    }
    -> tavern.bar_loop
